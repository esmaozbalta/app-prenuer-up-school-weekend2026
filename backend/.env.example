# Copy to .env or set in your shell / host (Render, etc.)
# ASP.NET Core: use double underscore for nested keys

ConnectionStrings__DefaultConnection=Host=YOUR-POOLER.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_DB_PASSWORD;SSL Mode=Require;

Jwt__Issuer=Archi.Api
Jwt__Audience=Archi.Mobile
Jwt__SigningKey=YOUR_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__ExpiryMinutes=120

ExternalApi__UseStubs=true

Cache__Redis__Enabled=false
Cache__Redis__ConnectionString=localhost:6379

Sync__UseStubs=true
Sync__MaxSteamGames=500
Sync__MaxCsvRows=500
Steam__ApiKey=YOUR_STEAM_API_KEY

Tmdb__ApiKey=YOUR_TMDB_API_KEY
GoogleBooks__ApiKey=YOUR_GOOGLE_BOOKS_API_KEY
Igdb__ClientId=YOUR_IGDB_CLIENT_ID
Igdb__ClientSecret=YOUR_IGDB_CLIENT_SECRET

OpenAi__ApiKey=YOUR_OPENAI_API_KEY
OpenAi__Model=gpt-4o-mini